  r4 d''8\f d'' f''4 g'' |
  a''4. g''8 f''4 e'' |
  d''4. a'8 d''4 e'' |
  f''4. g''8 a''2 |
  g''4. f''8 e''4. g''8 |
  f''2. r4 |
  d''8\ff e'' f'' g'' a'' bes'' c''' d''' |
  e'''4. d'''8 c'''4 bes'' |
  a''4. g''8 f''4 e'' |
  d''2.\ff r4 |
  r8 a''16\fff a'' r8 a'' d'''4 a'' |
